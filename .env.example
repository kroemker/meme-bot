DISCORD_BOT_TOKEN=
MEME_POST_CHANNEL_ID=
SOURCE_CHANNEL_IDS=
IMGFLIP_USERNAME=
IMGFLIP_PASSWORD=

# "anthropic" (default) or "openai"
LLM_PROVIDER=anthropic

# Required if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Required if LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

MESSAGES_PER_CHANNEL_LIMIT=100

# "daily_meme" (default) or "weekly_recap" — set by the workflow, not usually
# something you need to set yourself.
RUN_MODE=daily_meme
RECAP_LOOKBACK_DAYS=7
RECAP_MESSAGES_PER_CHANNEL_LIMIT=500
